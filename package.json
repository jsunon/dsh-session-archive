{
  "name": "dsh-session-archive",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "会话归档：每条新会话在 工作区/会话归档/ 下自动生成独立文件夹，内含 聊天记录.md、源码文件/、其他产出文件/，并按【开发/文案/方案/调试】命名。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
